{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wxpusher-parking",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/p/*", "/manage/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wxpusher-parking",
      "database_id": "28c33ce2-3dd6-40ef-a46e-057f01a7545b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SEND_COOLDOWN_SECONDS": "60"
  }
}
